set editor="vim"

set sendmail="/data/data/com.termux/files/usr/bin/msmtp"
set use_from=yes
set envelope_from=yes

set from="albertnedumudy@gmail.com"
set realname="Albert Nedumudy"

set folder="imaps://albertnedumudy@gmail.com@imap.gmail.com:993"
set spoolfile="+INBOX"
set record="+[Gmail]/Sent Mail"
set postponed="+[Gmail]/Drafts"

set imap_user="albertnedumudy@gmail.com"
set imap_pass="$GMAIL_PASSWORD"

set ssl_force_tls=yes
set ssl_starttls=yes

set header_cache="~/.cache/mutt/headers"
set message_cachedir="~/.cache/mutt/bodies"
set certificate_file="~/.mutt_certificates"
