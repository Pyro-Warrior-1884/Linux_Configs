#!/data/data/com.termux/files/usr/bin/bash

case "$1" in
    -p)
        shift
        echo "$*" >> "$HOME/packages"
        echo "Added Package Success:"
        tail -n 1 "$HOME/packages"
        ;;
    -f)
        shift
        echo "$*" >> "$HOME/filez"
        echo "Added File Success:"
        tail -n 1 "$HOME/filez"
        ;;
    *)
        echo "Usage: $(basename "$0") {-p|-f} text"
        exit 1
        ;;
esac
